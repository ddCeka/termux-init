# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.config/zsh/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.config}/zsh/powerlevel10k/p10k/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.config}/zsh/powerlevel10k/p10k/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/p10k.zsh.
() {
    local XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.config}/zsh
    [[ -f ~/.config/zsh/p10k.zsh ]] && source ~/.config/zsh/p10k.zsh
}

# Deduplicate PATH and FPATH arrays automatically on re-source
typeset -U path fpath

####               ####
#### shell options ####
####               ####

# Cd when entering just a path
setopt auto_cd
setopt cdablevars

# Enable extended glob
setopt extended_glob

# Prompt to correct typo
setopt correct

# Prompt confirmation after rm *
setopt rm_star_wait

# TZ Data (avoid subshell if already inherited)
[[ -z "$TZ" ]] && export TZ=$(getprop persist.sys.timezone 2>/dev/null)

# `grep default` highlight color
export GREP_COLORS='mt=1;32'

# Editor
editor="nvim"
export EDITOR=$editor
export SUDO_EDITOR=$editor
export VISUAL=$editor

# openjdk
# export JAVA_HOME=$PREFIX/lib/jvm/java-17-openjdk
export JAVA_HOME=$PREFIX/lib/jvm/java-21-openjdk
# export JAVA_HOME=$PREFIX/lib/jvm/java-25-openjdk

# set PATH so it includes custom directories (using Zsh built-in $OSTYPE instead of forking uname)
if [[ "$OSTYPE" == linux* ]]; then
    path+=("$HOME/bin" "$HOME/.local/bin" "$HOME/.local/lib" "$JAVA_HOME/bin")
    export MANPATH=":$MANPATH:$HOME/.local/share/man"
    # export LD_LIBRARY_PATH=/vendor/lib64:$PATH
fi

# SSH
export SSH_AUTH_SOCK=$PREFIX/var/run/ssh-agent.socket

# GPG (use Zsh's built-in $TTY; $XDG_SESSION_TYPE is typically unset in Termux)
[[ -n "$TTY" ]] && export GPG_TTY=$TTY

# Git
export GIT_CONFIG_GLOBAL=$HOME/.config/git/gitconfig
export FILTER_BRANCH_SQUELCH_WARNING=1

# gradle
export GRADLE_USER_HOME=$HOME/.local/gradle

# Android SDK & NDK
export ANDROID_API_LEVEL=24
export ANDROID_HOME=$HOME/.local/lib/android-sdk
export ANDROID_NDK_HOME=$ANDROID_HOME/android-ndk-r29
# path+=("$ANDROID_HOME/cmdline-tools/latest/bin")

# Python3
export PYTHONPYCACHEPREFIX=$HOME/.cache/Python
export PYTHONDONTWRITEBYTECODE=1

# npm
export npm_config_cache=$HOME/.cache/npm
export npm_config_userconfig=$HOME/.config/npm/npmrc

# cargo
export CARGO_HOME=$HOME/.local/cargo

# opam
# export OPAMROOT=$HOME/.local/opam
# [[ ! -r "$HOME/.local/opam/opam-init/init.zsh" ]] || source "$HOME/.local/opam/opam-init/init.zsh" > /dev/null 2> /dev/null

# locate shared storage path
export LOCATE_PATH="$HOME/.local/state/locate/sdcard.db"

# Wget
export WGETRC=$HOME/.config/wget/wgetrc

# Wego
export WEGORC=$HOME/.config/wego/wegorc

# parallel
export PARALLEL_HOME=$HOME/.config/parallel

# hstr
export HSTR_CONFIG=hicolor,prompt-bottom,raw-history-view
hstr_no_tiocsti() {
    zle -I
    { HSTR_OUT="$( { </dev/tty hstr -- ${BUFFER}; } 2>&1 1>&3 3>&- )"; } 3>&1;
    BUFFER="${HSTR_OUT}"
    CURSOR=${#BUFFER}
    zle redisplay
}
zle -N hstr_no_tiocsti
bindkey '\C-r' hstr_no_tiocsti
export HSTR_TIOCSTI=n

# proxy
# export PROXY=$HOME/.local/share/proxy/http.txt
export PROXY=$HOME/.local/share/proxy/socks4.txt
# export PROXY=$HOME/.local/share/proxy/socks5.txt

# fzf (with Termux clipboard & editor fallbacks)
export FZF_DEFAULT_COMMAND='fd --hidden --follow --exclude=.git --exclude=node_modules'
export FZF_COMPLETION_TRIGGER=','
export FZF_DEFAULT_OPTS="
--layout=reverse --info=inline --height=80% --multi --cycle --margin=1 --border=rounded
--preview '([[ -f {} ]] && (bat --style=numbers --color=always --line-range=:500 {} 2>/dev/null || cat {})) || ([[ -d {} ]] \
&& (eza -ahlT -L=2 -s=extension --group-directories-first --icons --git --git-ignore --no-user {} 2>/dev/null || ls -la {})) || echo {} 2> /dev/null | head -200'
--prompt=' ' --pointer='' --marker='✓'
--color='hl:148,hl+:154,prompt:blue,pointer:032,marker:010,bg+:000,gutter:000'
--preview-window=right:70%
--bind '?:toggle-preview'
--bind 'ctrl-a:select-all'
--bind 'ctrl-y:execute-silent(echo -n {+} | \${CLIPCOPY:-termux-clipboard-set})'
--bind 'ctrl-e:execute(\${EDITOR:-nvim} {+})+reload(eval \"\$FZF_DEFAULT_COMMAND\")'"
export FZF_CTRL_T_COMMAND='fd -t f -HF -E=.git -E=node_modules'
export FZF_TMUX_OPTS='-p 99%'

# Colored bat
export BAT_THEME="Visual Studio Dark+"

# Colored man
export MANPAGER="less -R --use-color -Dd+g -Du+b"

# History file
export HISTFILE=$HOME/.config/zsh/zsh_history

# Ignored list
export HISTORY_IGNORE="(ls|ll|la|l|bg|fg|history|hh|quit|q|clear|c|help|h|logout|exit)"

# Appearances
export TERM="xterm-256color"
# Only used this on desktop
# export LANGUAGE="C.UTF-8"
# export LANG="C.UTF-8"
# export LC_ALL="C.UTF-8"
# export LC_CTYPE="C.UTF-8"
# export LC_MESSAGES="C.UTF-8"

# Custom completions & fast cached compinit (runs BEFORE plugins)
fpath=("$HOME/.local/share/scripts/site-functions" "${fpath[@]}")
autoload -Uz compinit
zmodload -i zsh/complist zsh/datetime zsh/stat
() {
    local zcompdump="$HOME/.config/zsh/zcompdump"
    if [[ -f "$zcompdump" ]] && (( EPOCHSECONDS - $(zstat +mtime "$zcompdump") < 86400 )); then
        compinit -C -i -d "$zcompdump"
    else
        compinit -i -d "$zcompdump"
    fi
}

#	 ____  _             _
#	|  _ \| |_   _  __ _(_)_ __  ___
#	| |_) | | | | |/ _` | | '_ \/ __|
#	|  __/| | |_| | (_| | | | | \__ \
#	|_|   |_|\__,_|\__, |_|_| |_|___/
#	               |___/
source "$HOME/.config/zsh/powerlevel10k/powerlevel10k.zsh-theme"
source "$HOME/.config/zsh/plugins/completion.zsh"
source "$HOME/.config/zsh/plugins/history.zsh"
source "$HOME/.config/zsh/plugins/key-bindings.zsh"
source "$HOME/.config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh"
source "$HOME/.config/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.plugin.zsh"
source "$HOME/.config/zsh/plugins/you-should-use.zsh"
# fast-syntax-highlighting MUST be sourced last so it wraps all ZLE widgets properly
source "$HOME/.config/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"

# Aliases
[[ -f "$HOME/.config/zsh/aliases.zsh" ]] && source "$HOME/.config/zsh/aliases.zsh"

# Functions
[[ -f "$HOME/.config/zsh/functions.zsh" ]] && source "$HOME/.config/zsh/functions.zsh"

# Shell integration
[[ -f "$HOME/.local/share/scripts/shell-integration/integration.sh" ]] && source "$HOME/.local/share/scripts/shell-integration/integration.sh"

export PATH
PROMPT_EOL_MARK=""
last_repository=
